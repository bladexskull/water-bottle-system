rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Profiles are created via Admin SDK (/api/me) so clients cannot escalate role
      allow create, delete: if false;
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active
            && request.resource.data.approvalStatus == resource.data.approvalStatus
            && request.resource.data.email == resource.data.email);
    }

    match /dailySubmissions/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /eligibleDays/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /monthlyChallenges/{month} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /correctionRequests/{id} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dinnerEvents/{month} {
      allow read: if signedIn();
      allow write: if false;

      match /participants/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
